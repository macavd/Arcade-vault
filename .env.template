# Copia este archivo a `.env.local` y rellena los valores reales.
# `.env.local` NO debe commitearse (contiene la clave secreta de Resend).

# Clave de API de Resend (https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxx

# Destinatario de los mensajes del formulario de contacto
CONTACT_TO=hola@arcadevault.gg

# Remitente verificado en Resend (usa onboarding@resend.dev para pruebas)
CONTACT_FROM=Arcade Vault <onboarding@resend.dev>

# Supabase (https://supabase.com/dashboard → Project Settings → API)
# URL del proyecto
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# Publishable key moderna (formato sb_publishable_...), segura de exponer en cliente
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx
